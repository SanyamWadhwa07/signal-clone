# Copy to .env to override defaults (every value is optional for local development).

# SQLAlchemy async URL. Default: backend/data/signal.db
# DATABASE_URL=sqlite+aiosqlite:///./data/signal.db

# Signs session tokens. MUST be a long random value in production.
# JWT_SECRET=change-me

# Comma-separated list of allowed browser origins.
# CORS_ORIGINS=http://localhost:3000

# Seed demo users, chats and messages when the database is empty.
# SEED_ON_STARTUP=true

# Mock verification code accepted at login.
# MOCK_OTP=123456
